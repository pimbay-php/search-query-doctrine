{
  "name": "pimbay/search-query-doctrine",
  "type": "library",
  "description": "Doctrine DBAL/ORM adapters for pimbay/search-query over a QueryBuilder.",
  "keywords": [
    "search",
    "pagination",
    "doctrine",
    "dbal",
    "orm",
    "query-builder"
  ],
  "license": "Unlicense",
  "authors": [
    {
      "name": "Jan Sarmir",
      "email": "sarmir@pimbay.dev",
      "homepage": "https://pimbay.dev",
      "role": "Creator"
    }
  ],
  "homepage": "https://pimbay.dev",
  "support": {
    "source": "https://codeberg.org/pimbay-php/search-query-doctrine",
    "issues": "https://codeberg.org/pimbay-php/search-query-doctrine/issues",
    "docs": "https://pimbay.dev",
    "readme": "README.md"
  },
  "require": {
    "php": ">=8.3",
    "doctrine/dbal": "^3.8 || ^4.0",
    "pimbay/search-query": "^1.0.0"
  },
  "suggest": {
    "doctrine/orm": "Needed only when using Adapter\\OrmSimpleAdapter/OrmIdentityAdapter/OrmFetchJoinSafeAdapter"
  },
  "require-dev": {
    "doctrine/orm": "^3.0",
    "psr/cache": "^1 || ^2 || ^3",
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.34.2",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "robiningelbrecht/phpunit-coverage-tools": "^1.10",
    "symfony/var-exporter": "^6.4 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "PimBay\\SearchQuery\\Doctrine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PimBay\\SearchQuery\\Doctrine\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "docker:build": "docker compose build",
    "php:cs": [
      "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
      "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.tests.php --dry-run --diff"
    ],
    "php:cs:fix": [
      "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
      "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.tests.php"
    ],
    "php:stan": "vendor/bin/phpstan analyse",
    "test:coverage": "docker compose run --rm php83-dbal4 vendor/bin/phpunit --coverage-text --coverage-clover=var/tests/coverage.xml -d --min-coverage=100",
    "test:mutation": "docker compose run --rm php83-dbal4 vendor/bin/infection --threads=max --min-msi=100 --min-covered-msi=100",
    "test:83-dbal3": "docker compose run --rm php83-dbal3 vendor/bin/phpunit --no-coverage",
    "test:83-dbal4": "docker compose run --rm php83-dbal4 vendor/bin/phpunit --no-coverage",
    "test:84-dbal3": "docker compose run --rm php84-dbal3 vendor/bin/phpunit --no-coverage",
    "test:84-dbal4": "docker compose run --rm php84-dbal4 vendor/bin/phpunit --no-coverage",
    "test:85-dbal3": "docker compose run --rm php85-dbal3 vendor/bin/phpunit --no-coverage",
    "test:85-dbal4": "docker compose run --rm php85-dbal4 vendor/bin/phpunit --no-coverage",
    "test:all": [
      "@test:83-dbal3",
      "@test:83-dbal4",
      "@test:84-dbal3",
      "@test:84-dbal4",
      "@test:85-dbal3",
      "@test:85-dbal4"
    ],
    "ci": [
      "@php:cs",
      "@php:stan",
      "@test:all",
      "@test:mutation"
    ]
  }
}
